{
  "cleanUrls": false,
  "buildCommand": "node -e \"const fs=require('fs');const k=process.env.POSTHOG_KEY||'';fs.writeFileSync('analytics.js',fs.readFileSync('analytics.js','utf8').replace('__POSTHOG_KEY__',k));console.log(k?'PostHog key injected':'POSTHOG_KEY not set')\"",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/blog/:slug/", "destination": "/blog/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/relay/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/relay/array/:path*", "destination": "https://us-assets.i.posthog.com/array/:path*" },
    { "source": "/relay/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/editor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
